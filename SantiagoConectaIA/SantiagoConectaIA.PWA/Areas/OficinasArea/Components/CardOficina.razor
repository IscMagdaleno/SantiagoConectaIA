@using SantiagoConectaIA.Share.Objects.OficinasModule
@inherits EngramaComponent
@inject IDialogService DialogService

<MudCard Class="service-card" Style="height: 100%; display: flex; flex-direction: column;">
    <MudCardContent Style="text-align: center; padding: 2rem 1.5rem; flex-grow: 1;">
        <div class="d-flex justify-center mb-3">
            <div class="d-flex align-center justify-center rounded-2xl" 
                 style="width: 64px; height: 64px; background: linear-gradient(135deg, rgba(165,10,58,0.12) 0%, rgba(225,29,72,0.22) 100%); color: #A50A3A; box-shadow: 0 4px 14px rgba(165,10,58,0.08);">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" />
            </div>
        </div>

        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #0F172A; margin: 0.75rem 0 0.5rem 0; line-height: 1.25;">
            @Oficina.vchNombre
        </MudText>

        <MudText Typo="Typo.body2" Style="color: #64748B; line-height: 1.6;">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Primary" Class="mr-1" /> @Oficina.vchDireccion
        </MudText>
        
        @if(!string.IsNullOrEmpty(Oficina.vchTelefono))
        {
            <MudText Typo="Typo.body2" Style="color: #64748B;" Class="mt-1">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" Class="mr-1" /> @Oficina.vchTelefono
            </MudText>
        }

    </MudCardContent>

    <MudCardActions Style="padding: 1rem 1.5rem; margin-top: auto; border-top: 1px solid rgba(226, 232, 240, 0.6);">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="rounded-lg px-3" OnClick="OnClickVer">Ver</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="ml-2 rounded-lg px-3" OnClick="OnClickEditar">Editar</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="rounded-lg" OnClick="@(() => OnClickEliminar(Oficina))">Eliminar</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public Oficina Oficina { get; set; }
    [Parameter] public EventCallback<Oficina> OnView { get; set; }
    [Parameter] public EventCallback<Oficina> OnEdit { get; set; }
    [Parameter] public EventCallback<Oficina> OnDelete { get; set; }
}
