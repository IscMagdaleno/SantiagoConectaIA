@using SantiagoConectaIA.PWA.Areas.EventosArea.Utiles
@using SantiagoConectaIA.PWA.Shared.Workspace
@using SantiagoConectaIA.Share.Objects.EventosModulo
@inherits EngramaWorkspaceComponent

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Datos del Evento" Icon="@Icons.Material.Filled.Info">
        <MudCard Elevation="0">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
                    <MudText Typo="Typo.h6">Información del Evento</MudText>
                    
                    @if (EstadoControl != TipoEstadoControl.Lectura)
                    {
                        <MudFileUpload T="IBrowserFile" Accept=".png, .jpg, .jpeg, .webp" FilesChanged="EscanearFlyerConIA" Disabled="@_isScanningIA">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Secondary" 
                                           StartIcon="@(_isScanningIA ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.AutoAwesome)"
                                           Disabled="@_isScanningIA">
                                    @(_isScanningIA ? "Analizando Cartel con IA..." : "Autocompletar con IA desde Cartel")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    }
                </div>

                @if (_isScanningIA)
                {
                    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-3" />
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        Analizando la imagen del evento con Gemini Vision: extrayendo fechas, lugar, precios y redactando la descripción...
                    </MudAlert>
                }

                @if (!string.IsNullOrEmpty(Model?.vchImagenPortada))
                {
                    <MudPaper Class="pa-3 mb-4 d-flex align-center gap-4" Elevation="1" Outlined="true">
                        <MudImage Src="@Model.vchImagenPortada" Height="100" Width="140" ObjectFit="ObjectFit.Cover" Class="rounded-lg" Elevation="1" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Imagen de Portada Configurada</MudText>
                            <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 450px;">@Model.vchImagenPortada</MudText>
                        </div>
                    </MudPaper>
                }

                @if (Model != null)
                {
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchNombre"
                                          Label="Nombre del Evento"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="int?" @bind-Value="Model.iIdCategoriaEvento"
                                       Label="Categoría"
                                       Variant="Variant.Outlined"
                                       Disabled="@(EstadoControl == TipoEstadoControl.Lectura)"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (var cat in Data.LstCategorias)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)cat.iIdCategoriaEvento)">@cat.vchNombre</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Model.nvchDescripcion"
                                          Label="Descripción"
                                          Variant="Variant.Outlined"
                                          Lines="4"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <div class="d-flex gap-2 w-100">
                                <MudDatePicker @bind-Date="FechaInicioDate"
                                               Label="Fecha de Inicio"
                                               Variant="Variant.Outlined"
                                               Disabled="@(EstadoControl == TipoEstadoControl.Lectura)"
                                               Required="true"
                                               Class="flex-grow-1" />
                                <MudTimePicker @bind-Time="FechaInicioTime"
                                               Label="Hora Inicio"
                                               Variant="Variant.Outlined"
                                               Disabled="@(EstadoControl == TipoEstadoControl.Lectura)"
                                               Required="true"
                                               Class="flex-grow-1" />
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <div class="d-flex gap-2 w-100">
                                <MudDatePicker @bind-Date="FechaFinDate"
                                               Label="Fecha de Fin (Opcional)"
                                               Variant="Variant.Outlined"
                                               Disabled="@(EstadoControl == TipoEstadoControl.Lectura)"
                                               Class="flex-grow-1" />
                                <MudTimePicker @bind-Time="FechaFinTime"
                                               Label="Hora Fin"
                                               Variant="Variant.Outlined"
                                               Disabled="@(EstadoControl == TipoEstadoControl.Lectura)"
                                               Class="flex-grow-1" />
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchLugar"
                                          Label="Lugar / Sede"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchCostoTexto"
                                          Label="Costo (ej. Gratis, $50, $100-$200)"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Model.vchDireccion"
                                          Label="Dirección"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Model.flLatitud"
                                             Label="Latitud"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Model.flLongitud"
                                             Label="Longitud"
                                             Variant="Variant.Outlined"
                                             HideSpinButtons="true"
                                             Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>
                    </MudGrid>
                }

                @if (Model != null)
                {
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchOrganizador"
                                          Label="Organizador"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchTelefono"
                                          Label="Teléfono de Contacto"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchCorreo"
                                          Label="Correo Electrónico"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Model.vchUrlOficial"
                                          Label="URL Oficial / Boletos"
                                          Variant="Variant.Outlined"
                                          Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="Model.bDestacado"
                                       Label="Evento Destacado"
                                       Color="Color.Warning"
                                       Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="Model.bEstatus"
                                       Label="Activo"
                                       Color="Color.Success"
                                       Disabled="@(EstadoControl == TipoEstadoControl.Lectura)" />
                        </MudItem>
                    </MudGrid>
                }
            </MudCardContent>
        </MudCard>
    </MudTabPanel>

    <MudTabPanel Text="Imágenes" Icon="@Icons.Material.Filled.Image" Disabled="@(Model.iIdEvento <= 0)">
        <MudCard Elevation="0">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">Imágenes del Evento</MudText>
                <TabImagenesEvento EventoModel="@Model" />
            </MudCardContent>
        </MudCard>
    </MudTabPanel>

    <MudTabPanel Text="Sucursales" Icon="@Icons.Material.Filled.Store" Disabled="@(Model.iIdEvento <= 0)">
        <MudCard Elevation="0">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">Sucursales / Locales del Evento</MudText>
                <TabSucursales EventoModel="@Model" />
            </MudCardContent>
        </MudCard>
    </MudTabPanel>
</MudTabs>
