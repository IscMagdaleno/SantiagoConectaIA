@using SantiagoConectaIA.PWA.Areas.EventosArea.Utiles
@using SantiagoConectaIA.PWA.Shared.Workspace
@using SantiagoConectaIA.Share.Utilities
@inherits EngramaWorkspaceComponent

<MudGrid Justify="Justify.SpaceBetween" Class="mb-4">
    <MudItem>
        <MudText Typo="Typo.h4" Style="color: #A50A3A; font-weight: bold;">
            Catálogo de Eventos
        </MudText>
    </MudItem>
</MudGrid>

<MudGrid>
    @if (Data != null && Data.LstRegistros != null)
    {
        <MudItem xs="12">
            <MudTextField @bind-Value="filtroTexto"
                          Label="Buscar Evento"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          TextChanged="CuandoCambiaTexto"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mb-4" />
        </MudItem>

        @foreach (var registro in listaFiltrada)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="service-card" Style="height: 100%; display: flex; flex-direction: column;">
                    @if (!string.IsNullOrWhiteSpace(registro.vchImagenPortada))
                    {
                        <div style="position: relative; overflow: hidden;">
                            <MudCardMedia Image="@registro.vchImagenPortada" Height="170" Style="transition: transform 0.4s ease;" />
                            @if (registro.bDestacado)
                            {
                                <div style="position: absolute; top: 10px; right: 10px; background: rgba(245, 158, 11, 0.9); backdrop-filter: blur(8px); color: white; padding: 2px 8px; border-radius: 8px; font-size: 0.7rem; font-weight: 700; display: flex; align-items: center; gap: 4px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> Destacado
                                </div>
                            }
                        </div>
                    }
                    <MudCardContent Style="padding: 1.5rem; flex-grow: 1;">
                        @if (string.IsNullOrWhiteSpace(registro.vchImagenPortada))
                        {
                            <div class="d-flex justify-space-between align-center mb-2">
                                <div class="d-flex align-center justify-center rounded-xl" 
                                     style="width: 48px; height: 48px; background: linear-gradient(135deg, rgba(165,10,58,0.12) 0%, rgba(225,29,72,0.22) 100%); color: #A50A3A;">
                                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Medium" />
                                </div>
                                @if (registro.bDestacado)
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                                        Destacado
                                    </MudChip>
                                }
                            </div>
                        }

                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #0F172A; line-height: 1.25; margin-bottom: 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @registro.vchNombre
                        </MudText>

                        <div class="d-flex align-center gap-1 mb-1" style="color: #64748B; font-size: 0.85rem;">
                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Primary" />
                            <span>@registro.dtFechaInicio.ToUsuarioLocal().ToString("dd MMM yyyy - HH:mm")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(registro.vchLugar))
                        {
                            <div class="d-flex align-center gap-1 mb-2" style="color: #64748B; font-size: 0.85rem;">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                <span class="text-truncate">@registro.vchLugar</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(registro.vchCostoTexto))
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="mt-1">
                                @registro.vchCostoTexto
                            </MudChip>
                        }
                    </MudCardContent>
                    <MudCardActions Style="padding: 1rem 1.5rem; margin-top: auto; border-top: 1px solid rgba(226, 232, 240, 0.6);">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="rounded-lg px-3" OnClick="@(() => OnViewRegistro(registro))">Ver</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="ml-2 rounded-lg px-3" OnClick="@(() => OnEditRegistro(registro))">Editar</MudButton>
                        <MudSpacer />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }

        @if (!listaFiltrada.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No se encontraron eventos que coincidan con la búsqueda.
                </MudAlert>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudItem>
    }
</MudGrid>
