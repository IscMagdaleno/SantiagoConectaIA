@using SantiagoConectaIA.PWA.Areas.EmpresasArea.Utiles
@using SantiagoConectaIA.PWA.Shared.Workspace
@inherits EngramaWorkspaceComponent

@* HEADER / NAVIGATION *@
<MudGrid Justify="Justify.SpaceBetween" Class="mb-4">
    <MudItem>
        <MudText Typo="Typo.h4" Style="color: #A50A3A; font-weight: bold;">
            Catálogo de Emprendimientos
        </MudText>
    </MudItem>
</MudGrid>

@* CONTENT *@
<MudGrid>
    @if (Data != null && Data.LstRegistros != null)
    {
        <MudItem xs="12">
            <MudTextField @bind-Value="filtroTexto"
                          Label="Buscar Empresa"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          TextChanged="CuandoCambiaTexto"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mb-4" />
        </MudItem>

        @foreach (var registro in listaFiltrada)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="service-card" Style="height: 100%; display: flex; flex-direction: column;">
                    <MudCardContent Style="text-align: center; padding: 2rem 1.5rem; flex-grow: 1;">
                        <div class="d-flex justify-center mb-3">
                            <div class="d-flex align-center justify-center rounded-2xl" 
                                 style="width: 64px; height: 64px; background: linear-gradient(135deg, rgba(165,10,58,0.12) 0%, rgba(225,29,72,0.22) 100%); color: #A50A3A; box-shadow: 0 4px 14px rgba(165,10,58,0.08);">
                                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Large" />
                            </div>
                        </div>

                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #0F172A; margin: 0.75rem 0 0.5rem 0; line-height: 1.25;">
                            @registro.vchNombreComercial
                        </MudText>

                        <MudText Typo="Typo.body2" Style="color: #64748B; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(registro.vchSlogan) ? "Emprendimiento de Santiago Papasquiaro" : registro.vchSlogan)
                        </MudText>

                        @if(!string.IsNullOrWhiteSpace(registro.vchTelefono))
                        {
                            <MudText Typo="Typo.body2" Style="color: #64748B;" Class="mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Primary" Class="mr-1" /> @registro.vchTelefono
                            </MudText>
                        }
                    </MudCardContent>
                    <MudCardActions Style="padding: 1rem 1.5rem; margin-top: auto; border-top: 1px solid rgba(226, 232, 240, 0.6);">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="rounded-lg px-3" OnClick="@(() => OnViewRegistro(registro))">Ver</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="ml-2 rounded-lg px-3" OnClick="@(() => OnEditRegistro(registro))">Editar</MudButton>
                        <MudSpacer />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }

        @if (!listaFiltrada.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    No se encontraron empresas que coincidan con la búsqueda.
                </MudAlert>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudItem>
    }
</MudGrid>
