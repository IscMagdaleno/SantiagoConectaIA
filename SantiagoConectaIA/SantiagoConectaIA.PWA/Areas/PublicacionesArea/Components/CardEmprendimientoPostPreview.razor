@using SantiagoConectaIA.Share.PostModels.EmpresasModulo
@using SantiagoConectaIA.Share.Objects.EmpresasModulo

<div id="@ElementId" class="instagram-post-container" style="width: 1080px; min-width: 1080px; max-width: 1080px; height: 1360px; min-height: 1360px; max-height: 1360px; background-color: #FFFFFF; box-sizing: border-box; font-family: 'Outfit', sans-serif; position: relative; overflow: hidden; display: flex; flex-direction: column;">
    
    <!-- BARRA SUPERIOR INSTITUCIONAL -->
    <div style="background: #FFFFFF; padding: 18px 44px; display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #F1F5F9; z-index: 2;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <img src="icons/logo-scia.png" alt="Logo" style="width: 52px; height: 52px; object-fit: contain;" />
            <div style="display: flex; flex-direction: column;">
                <span style="font-size: 28px; font-weight: 800; color: #880E4F; letter-spacing: -0.5px; line-height: 1.1;">
                    Santiago<span style="color: #D81B60;">Conecta</span>
                </span>
                <span style="font-size: 14px; font-weight: 700; color: #64748B; letter-spacing: 0.3px;">
                    Más Cerca, Más Rápido, Más Fácil
                </span>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px; background: #FFF1F5; padding: 8px 20px; border-radius: 999px; border: 1px solid #FCE7F3;">
            <span style="font-size: 16px; font-weight: 700; color: #D81B60;">
                Negocio Destacado
            </span>
        </div>
    </div>

    <!-- BANNER HERO CON FONDO Y OLAS SUAVES -->
    <div style="background: linear-gradient(135deg, #880E4F 0%, #D81B60 55%, #7B1FA2 100%); padding: 34px 40px 60px 40px; text-align: center; position: relative; color: white; overflow: hidden;">
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; z-index: 2;">
            
            <!-- LOGO CIRCULAR ELEGANTE -->
            @{
                var logoSrc = !string.IsNullOrWhiteSpace(LogoBase64) ? LogoBase64 : Detalle?.Empresa?.vchLogoUrl;
            }
            @if (!string.IsNullOrWhiteSpace(logoSrc))
            {
                <div style="width: 130px; height: 130px; border-radius: 50%; background: #FFFFFF; border: 4px solid #FFFFFF; box-shadow: 0 10px 26px rgba(0,0,0,0.28); overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                    <img src="@logoSrc" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                </div>
            }
            else
            {
                <div style="width: 120px; height: 120px; border-radius: 50%; background: #FFFFFF; border: 4px solid #FFFFFF; box-shadow: 0 10px 26px rgba(0,0,0,0.28); display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                    <span style="font-size: 54px;">🏪</span>
                </div>
            }

            <h1 style="font-size: 44px; font-weight: 800; text-transform: uppercase; margin: 0; letter-spacing: 0.5px; text-shadow: 0 4px 12px rgba(0,0,0,0.3);">
                @(Detalle?.Empresa?.vchNombreComercial ?? "Emprendimiento Local")
            </h1>

            @if (!string.IsNullOrWhiteSpace(Detalle?.Empresa?.vchSlogan))
            {
                <p style="font-size: 19px; font-style: italic; opacity: 0.95; margin: 6px 0 0 0; max-width: 800px;">
                    "@Detalle.Empresa.vchSlogan"
                </p>
            }

            <!-- REDES SOCIALES DISPONIBLES EN EL BANNER CON ÍCONOS OFICIALES -->
            @if (RedesDisponibles.Any())
            {
                <div style="margin-top: 16px; display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center;">
                    @foreach (var red in RedesDisponibles.Take(4))
                    {
                        var redTipo = GetTipoRed(red.vchPlataforma);
                        <div style="background: rgba(255,255,255,0.2); padding: 7px 18px; border-radius: 999px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.35); font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 8px;">
                            @if (redTipo == "whatsapp")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366">
                                    <path d="M12.031 2c-5.516 0-9.998 4.479-9.998 9.995 0 1.763.459 3.486 1.332 5.006L2 22l5.133-1.346c1.464.799 3.111 1.22 4.898 1.22h.005c5.514 0 9.996-4.479 9.996-9.995 0-2.671-1.04-5.183-2.929-7.071C17.214 2.92 14.702 2 12.031 2zm0 18.314c-1.503 0-2.977-.405-4.264-1.17l-.306-.182-3.167.831.846-3.088-.2-.318c-.843-1.342-1.288-2.909-1.288-4.512 0-4.582 3.728-8.31 8.315-8.31 2.22 0 4.308.865 5.878 2.436 1.571 1.57 2.436 3.659 2.436 5.88 0 4.583-3.728 8.312-8.315 8.312zm4.557-6.223c-.25-.125-1.478-.729-1.708-.812-.23-.083-.397-.125-.564.125-.167.25-.647.812-.793.979-.146.167-.292.188-.542.063-.25-.125-1.056-.39-2.012-1.242-.744-.663-1.247-1.482-1.393-1.732-.146-.25-.016-.385.109-.51.112-.112.25-.292.375-.438.125-.146.167-.25.25-.417.083-.167.042-.313-.021-.438s-.564-1.359-.773-1.862c-.204-.49-.411-.424-.564-.432l-.481-.008c-.167 0-.438.063-.667.313-.229.25-.876.856-.876 2.087 0 1.231.897 2.42 1.022 2.587.125.167 1.765 2.696 4.277 3.782.598.258 1.065.413 1.43.529.602.191 1.15.164 1.583.099.483-.072 1.478-.604 1.687-1.189.208-.584.208-1.084.146-1.189-.062-.104-.229-.167-.479-.292z"/>
                                </svg>
                            }
                            else if (redTipo == "facebook")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="#1877F2">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                            }
                            else if (redTipo == "instagram")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="#E4405F">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                                </svg>
                            }
                            <span>@red.vchPlataforma</span>
                        </div>
                    }
                </div>
            }

        </div>

        <!-- OLAS SUAVES BLANCAS VECTORIALES CONECTADAS AL FONDO BLANCO -->
        <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 50px; pointer-events: none; z-index: 1;">
            <svg viewBox="0 0 1200 120" preserveAspectRatio="none" style="width: 100%; height: 100%; display: block;">
                <path d="M0,0 C150,90 350,-40 500,45 C650,130 900,10 1200,50 L1200,120 L0,120 Z" fill="rgba(255, 255, 255, 0.45)"></path>
                <path d="M0,25 C200,110 420,-10 620,55 C820,120 1020,30 1200,75 L1200,120 L0,120 Z" fill="#FFFFFF"></path>
            </svg>
        </div>
    </div>

    <!-- CUERPO PRINCIPAL CON 2 COLUMNAS DINÁMICAS (INFO + CATÁLOGO) -->
    <div style="padding: 22px 36px; flex: 1; display: grid; grid-template-columns: 370px 1fr; gap: 22px; box-sizing: border-box; overflow: hidden; background: #FFFFFF;">
        
        <!-- COLUMNA IZQUIERDA: SOBRE NOSOTROS, MISIÓN, VISIÓN Y UBICACIONES -->
        <div style="display: flex; flex-direction: column; gap: 14px; overflow: hidden; background: #FFFFFF;">
            
            <!-- TARJETA: SOBRE NOSOTROS + MISIÓN + VISIÓN -->
            <div style="background: #FFFFFF; border-radius: 20px; padding: 22px; border: 1.5px solid #F1F5F9; display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 24px;">ℹ️</span>
                    <h3 style="font-size: 21px; font-weight: 800; color: #0F172A; margin: 0;">Sobre Nosotros</h3>
                </div>
                
                @if (!string.IsNullOrWhiteSpace(Detalle?.Empresa?.nvchDescripcion))
                {
                    <p style="font-size: 15px; color: #475569; line-height: 1.45; margin: 0; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;">
                        @Detalle.Empresa.nvchDescripcion
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Detalle?.Empresa?.nvchMision))
                {
                    <div style="background: #FFFFFF; border-left: 4px solid #3B82F6; padding: 10px 12px; border-radius: 6px; border-top: 1px solid #F1F5F9; border-right: 1px solid #F1F5F9; border-bottom: 1px solid #F1F5F9;">
                        <span style="font-size: 13px; font-weight: 800; color: #0F172A; display: block; margin-bottom: 3px;">Nuestra Misión</span>
                        <p style="font-size: 13px; color: #334155; margin: 0; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @Detalle.Empresa.nvchMision
                        </p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Detalle?.Empresa?.nvchVision))
                {
                    <div style="background: #FFFFFF; border-left: 4px solid #10B981; padding: 10px 12px; border-radius: 6px; border-top: 1px solid #F1F5F9; border-right: 1px solid #F1F5F9; border-bottom: 1px solid #F1F5F9;">
                        <span style="font-size: 13px; font-weight: 800; color: #0F172A; display: block; margin-bottom: 3px;">Nuestra Visión</span>
                        <p style="font-size: 13px; color: #334155; margin: 0; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @Detalle.Empresa.nvchVision
                        </p>
                    </div>
                }
            </div>

            <!-- TARJETA: UBICACIONES (SI TIENE REGISTRADAS) -->
            @if (UbicacionesDisponibles.Any())
            {
                var ubi = UbicacionesDisponibles.First();
                <div style="background: #FFFFFF; border-radius: 20px; padding: 18px 22px; border: 1.5px solid #F1F5F9; display: flex; flex-direction: column;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <span style="font-size: 22px;">📍</span>
                        <h4 style="font-size: 18px; font-weight: 800; color: #0F172A; margin: 0;">Ubicación & Punto de Entrega</h4>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ubi.vchAlias))
                    {
                        <span style="font-size: 14px; font-weight: 700; color: #880E4F; margin-bottom: 2px;">
                            @ubi.vchAlias
                        </span>
                    }
                    <p style="font-size: 13px; color: #475569; line-height: 1.35; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @(ubi.vchDireccion ?? "Santiago Papasquiaro, Dgo.")
                    </p>
                </div>
            }

        </div>

        <!-- COLUMNA DERECHA: CATÁLOGO DE PRODUCTOS / SERVICIOS CON FOTOS REALES -->
        <div style="background: #FFFFFF; border-radius: 20px; padding: 22px; border: 1.5px solid #F1F5F9; display: flex; flex-direction: column; overflow: hidden;">
            
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 24px;">🗂️</span>
                    <h3 style="font-size: 21px; font-weight: 800; color: #0F172A; margin: 0;">Catálogo de Productos y Servicios</h3>
                </div>
                @if (TotalCategorias > 0)
                {
                    <span style="font-size: 13px; font-weight: 700; color: #880E4F; background: #FCE7F3; padding: 4px 12px; border-radius: 999px;">
                        @(TotalCategorias) Categoría@(TotalCategorias > 1 ? "s" : "")
                    </span>
                }
            </div>

            <!-- GRID DE PRODUCTOS (4 PRODUCTOS DESTACADOS) -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; flex: 1; align-content: start;">
                @{
                    var prods = GetProductos();
                }
                @if (prods.Any())
                {
                    @foreach (var prod in prods.Take(4))
                    {
                        var imgSrc = GetImagenProducto(prod);
                        <div style="background: #FFFFFF; border: 1.5px solid #F1F5F9; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column;">
                            
                            <!-- FOTO REAL DEL PRODUCTO (DESDE BASE64 O URL) -->
                            @if (!string.IsNullOrWhiteSpace(imgSrc))
                            {
                                <div style="width: 100%; height: 165px; background: #FFFFFF; overflow: hidden;">
                                    <img src="@imgSrc" alt="@prod.vchNombre" style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                            }
                            else
                            {
                                <div style="width: 100%; height: 165px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 44px;">
                                    🧁
                                </div>
                            }

                            <!-- DETALLES DEL PRODUCTO -->
                            <div style="padding: 10px 14px; display: flex; flex-direction: column; flex: 1; justify-content: space-between; background: #FFFFFF;">
                                <div>
                                    <span style="font-size: 15px; font-weight: 800; color: #0F172A; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">
                                        @prod.vchNombre
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(prod.nvchDescripcionCorta))
                                    {
                                        <p style="font-size: 12px; color: #64748B; margin: 3px 0 0 0; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">
                                            @prod.nvchDescripcionCorta
                                        </p>
                                    }
                                </div>

                                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 6px;">
                                    @if (prod.mPrecio > 0)
                                    {
                                        <span style="font-size: 16px; font-weight: 800; color: #059669;">
                                            $@prod.mPrecio.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 13px; font-weight: 700; color: #64748B;">
                                            Consultar precio
                                        </span>
                                    }
                                    <div style="display: flex; align-items: center;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366">
                                            <path d="M12.031 2c-5.516 0-9.998 4.479-9.998 9.995 0 1.763.459 3.486 1.332 5.006L2 22l5.133-1.346c1.464.799 3.111 1.22 4.898 1.22h.005c5.514 0 9.996-4.479 9.996-9.995 0-2.671-1.04-5.183-2.929-7.071C17.214 2.92 14.702 2 12.031 2zm0 18.314c-1.503 0-2.977-.405-4.264-1.17l-.306-.182-3.167.831.846-3.088-.2-.318c-.843-1.342-1.288-2.909-1.288-4.512 0-4.582 3.728-8.31 8.315-8.31 2.22 0 4.308.865 5.878 2.436 1.571 1.57 2.436 3.659 2.436 5.88 0 4.583-3.728 8.312-8.315 8.312zm4.557-6.223c-.25-.125-1.478-.729-1.708-.812-.23-.083-.397-.125-.564.125-.167.25-.647.812-.793.979-.146.167-.292.188-.542.063-.25-.125-1.056-.39-2.012-1.242-.744-.663-1.247-1.482-1.393-1.732-.146-.25-.016-.385.109-.51.112-.112.25-.292.375-.438.125-.146.167-.25.25-.417.083-.167.042-.313-.021-.438s-.564-1.359-.773-1.862c-.204-.49-.411-.424-.564-.432l-.481-.008c-.167 0-.438.063-.667.313-.229.25-.876.856-.876 2.087 0 1.231.897 2.42 1.022 2.587.125.167 1.765 2.696 4.277 3.782.598.258 1.065.413 1.43.529.602.191 1.15.164 1.583.099.483-.072 1.478-.604 1.687-1.189.208-.584.208-1.084.146-1.189-.062-.104-.229-.167-.479-.292z"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div style="grid-column: span 2; padding: 40px; text-align: center; color: #94A3B8;">
                        <span style="font-size: 36px; display: block; margin-bottom: 8px;">✨</span>
                        <span>Visita el perfil completo en nuestro portal</span>
                    </div>
                }
            </div>

            <!-- FOOTER DE CONTACTO -->
            <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid #EDF2F7; display: flex; align-items: center; justify-content: space-between;">
                <span style="font-size: 14px; font-weight: 700; color: #64748B;">
                    🌐 santiagopapasquiaro.com.mx/emprendimientos
                </span>
                <span style="font-size: 13px; font-weight: 800; color: #D81B60; background: #FFF1F5; padding: 4px 12px; border-radius: 999px;">
                    #ApoyaLoLocal
                </span>
            </div>
        </div>

    </div>

</div>

@code {
    [Parameter] public string ElementId { get; set; } = "post-card-emprendimiento-capture";
    [Parameter] public PostSaveEmprendimientoFull? Detalle { get; set; }
    [Parameter] public string? LogoBase64 { get; set; }
    [Parameter] public Dictionary<string, string> ProductosImagenesBase64 { get; set; } = new();

    private IEnumerable<EmpresaRedSocial> RedesDisponibles =>
        Detalle?.RedesSociales?.Where(r => r.bActivo && !string.IsNullOrWhiteSpace(r.vchPlataforma)) ?? Enumerable.Empty<EmpresaRedSocial>();

    private IEnumerable<EmpresaUbicacion> UbicacionesDisponibles =>
        Detalle?.Ubicaciones?.Where(u => u.bActivo && (!string.IsNullOrWhiteSpace(u.vchDireccion) || !string.IsNullOrWhiteSpace(u.vchAlias))) ?? Enumerable.Empty<EmpresaUbicacion>();

    private int TotalCategorias =>
        Detalle?.Categorias?.Count ?? 0;

    private List<ProductoServicio> GetProductos()
    {
        if (Detalle?.Categorias == null) return new List<ProductoServicio>();
        return Detalle.Categorias
            .SelectMany(c => c.Productos ?? new List<ProductoServicio>())
            .Where(p => p.bEstatus)
            .ToList();
    }

    private string? GetImagenProducto(ProductoServicio prod)
    {
        if (string.IsNullOrWhiteSpace(prod.vchImagenUrl)) return null;
        var url = prod.vchImagenUrl.Trim();
        if (ProductosImagenesBase64 != null && ProductosImagenesBase64.TryGetValue(url, out var base64) && !string.IsNullOrWhiteSpace(base64))
        {
            return base64;
        }
        return url;
    }

    private static string GetTipoRed(string? plataforma)
    {
        var p = (plataforma ?? "").ToLowerInvariant();
        if (p.Contains("whats")) return "whatsapp";
        if (p.Contains("face")) return "facebook";
        if (p.Contains("insta")) return "instagram";
        return "web";
    }
}
