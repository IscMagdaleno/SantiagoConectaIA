@using SantiagoConectaIA.PWA.Shared.Common
@using SantiagoConectaIA.PWA.Shared.Workspace
@inherits LayoutComponentBase
@implements IDisposable
@inject WorkspaceService WorkspaceService
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<MudThemeProvider Theme="@_customTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />


<div class="mesh-bg"></div>

<MudLayout>
    <!-- Header fijo con navegación innovadora Glassmorphism -->
    <!-- Header fijo limpio y moderno con Glassmorphism nítido -->
    <MudAppBar Elevation="0" Fixed="true" Class="modern-appbar px-4">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="d-flex align-center justify-space-between px-0 position-relative">
            <!-- Izquierda: Solo Inicio (compacto en móvil, con texto en pantallas sm+) -->
            <div class="d-flex align-center header-home-wrap">
                <MudIconButton Href="/" Color="Color.Inherit" Icon="@Icons.Material.Filled.Home" Class="nav-button-clean d-inline-flex d-sm-none pa-2" />
                <MudButton Href="/" Color="Color.Inherit" Class="nav-button-clean d-none d-sm-inline-flex" StartIcon="@Icons.Material.Filled.Home">
                    Inicio
                </MudButton>
            </div>

            <!-- Centro: Logo e Identidad Municipal Centrados -->
            <div class="header-center-brand d-flex align-center cursor-pointer" @onclick='() => CloseMobileMenu()'>
                <img src="icons/logo-scia.png" alt="Santiago Conecta Logo" class="brand-logo-img mr-2 mr-sm-3" />
                <div class="text-left">
                    <MudText Typo="Typo.h6" Class="brand-title">
                        Santiago <span class="brand-title-accent">Conecta</span>
                    </MudText>
                    <MudText Typo="Typo.caption" Class="brand-subtitle d-none d-sm-block">
                        Portal Digital & IA
                    </MudText>
                </div>
            </div>

            <!-- Derecha: Espacio balanceado para mantener centrado simétrico -->
            <div class="d-flex align-center justify-end header-spacer-right"></div>
        </MudContainer>
    </MudAppBar>

    <!-- Botón Flotante Fijo en la Esquina Inferior Derecha -->
    <MudButton Variant="Variant.Filled"
               Class="floating-menu-fab d-flex align-center gap-2"
               OnClick="@AbrirMenuHub">
        <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Medium" />
        <span class="d-none d-sm-inline" style="font-weight: 700; letter-spacing: 0.2px;">Menú</span>
    </MudButton>

    <!-- Menú móvil desplegable con efecto Glassmorphism completo -->
    <MudCollapse Expanded="@_mobileMenuOpen" Class="mobile-menu" Style="position: fixed; top: 64px; left: 0; width: 100%; z-index: 1200; max-height: calc(100vh - 64px); overflow-y: auto;">
        <div class="mobile-glass-menu pa-4">
            <MudGrid Spacing="1">
                <MudItem xs="6">
                    <MudButton Href="/" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start" OnClick="@CloseMobileMenu">
                        <MudIcon Icon="Icons.Material.Filled.Home" Class="mr-2" Size="Size.Small" /> Inicio
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestTramites(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Description" Class="mr-2" Size="Size.Small" /> Trámites
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestNoticias(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Article" Class="mr-2" Size="Size.Small" /> Noticias
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestPublicaciones(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Custom.Brands.Facebook" Class="mr-2" Size="Size.Small" /> Publicaciones
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestOficinas(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Business" Class="mr-2" Size="Size.Small" /> Oficinas
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestChatbot(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Chat" Class="mr-2" Size="Size.Small" /> ChatBot IA
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestEmpresas(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Storefront" Class="mr-2" Size="Size.Small" /> Empresas
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestEventos(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Event" Class="mr-2" Size="Size.Small" /> Eventos
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestPageVisits(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.BarChart" Class="mr-2" Size="Size.Small" /> Estadísticas
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton OnClick="@(() => { WorkspaceService.RequestMockup(); CloseMobileMenu(); })" FullWidth="true" Class="mobile-nav-item d-flex align-center justify-start">
                        <MudIcon Icon="Icons.Material.Filled.Extension" Class="mr-2" Size="Size.Small" /> Mockup
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>
    </MudCollapse>

    <!-- Contenido principal -->
    <MudMainContent Style="padding-top: 84px; min-height: calc(100vh - 84px); background-color: transparent;" @oncontextmenu:preventDefault="true">

        <Loading></Loading>

        @if (tabsList.Count != 0)
        {
            <div class="px-2 px-md-4">
                <ToolbarSuperior />

                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" 
                         Class="glass-tabs mx-1 mx-md-4 mb-6"
                         KeepPanelsAlive="true"
                         ActivePanelIndex="tabsSelectedIndex" 
                         ActivePanelIndexChanged="OnTabChanged">
                    @foreach (var tab in tabsList)
                    {
                        <MudTabPanel ID="@tab.Id">
                            <ChildContent>
                                <div class="glass-tab-panel pa-3 pa-md-6">
                                    @tab.Componente
                                </div>
                            </ChildContent>
                            <TabContent>
                                <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" AnchorOrigin="Origin.BottomCenter">
                                    <ActivatorContent>
                                        <div class="d-flex align-center px-3 py-1 tab-item-inner" style="cursor: pointer; min-width: 100px;">
                                            <MudIcon Icon="@tab.Icono" Class="mr-2" Size="Size.Small" />
                                            <MudText Typo="Typo.body2" Class="tab-label-text">@tab.Text</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                                           Size="Size.Small" 
                                                           Class="ml-2 pa-1 rounded-circle tab-close-btn" 
                                                           OnClick="@(async () => await CloseCurrentTabAsync(tab.EstadoControl == TipoEstadoControl.Alta || tab.EstadoControl == TipoEstadoControl.Edicion, tab.Id))" />
                                        </div>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Close" OnClick="@(async () => await CloseCurrentTabAsync(tab.EstadoControl == TipoEstadoControl.Alta || tab.EstadoControl == TipoEstadoControl.Edicion, tab.Id))">Cerrar pestaña</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.CloseFullscreen" OnClick="CloseOtherTabsAsync">Cerrar las demás</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep" OnClick="CloseAllTabsAsync" Disabled="@(tabsList.Count <= 1)">Cerrar todas</MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </TabContent>
                        </MudTabPanel>
                    }
                </MudTabs>
            </div>
        }
        else
        {
            @Body
        }
    </MudMainContent>


</MudLayout>



@code {
    private bool _mobileMenuOpen = false;

    private List<WorkspaceTab> tabsList = new List<WorkspaceTab>();
    private int tabsSelectedIndex = 0;

    private void AbrirMenuHub()
    {
        CloseMobileMenu();
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            NoHeader = true, 
            MaxWidth = MaxWidth.Medium 
        };
        DialogService.Show<ModalMenuHub>(string.Empty, options);
    }

    protected override void OnInitialized()
    {
        WorkspaceService.OnMenuTabSelected += AddTab;
        WorkspaceService.MenuChanged += () => InvokeAsync(StateHasChanged);
        WorkspaceService.TabNameChanged += RenameCurrentTab;
        WorkspaceService.TabStateChanged += SetTabState;
        WorkspaceService.CloseCurrentTab += async (withWarning) => await CloseCurrentTabAsync(withWarning);
        
        WorkspaceService.OnTramitesRequest += AbrirTramitesEnTab;
        WorkspaceService.OnNoticiasRequest += AbrirNoticiasEnTab;
        WorkspaceService.OnChatbotRequest += AbrirChatbotEnTab;
        WorkspaceService.OnOficinasRequest += AbrirOficinasEnTab;
        WorkspaceService.OnMockupRequest += AbrirMockupEnTab; // Evento del Mockup
        WorkspaceService.OnEmpresasRequest += AbrirEmpresasEnTab;
        WorkspaceService.OnEventosRequest += AbrirEventosEnTab;
        WorkspaceService.OnPageVisitsRequest += AbrirPageVisitsEnTab;
        WorkspaceService.OnPublicacionesRequest += AbrirPublicacionesEnTab;
    }

    public void Dispose()
    {
        WorkspaceService.OnMenuTabSelected -= AddTab;
        WorkspaceService.OnTramitesRequest -= AbrirTramitesEnTab;
        WorkspaceService.OnNoticiasRequest -= AbrirNoticiasEnTab;
        WorkspaceService.OnChatbotRequest -= AbrirChatbotEnTab;
        WorkspaceService.OnOficinasRequest -= AbrirOficinasEnTab;
        WorkspaceService.OnMockupRequest -= AbrirMockupEnTab; // Evento del Mockup
        WorkspaceService.OnEmpresasRequest -= AbrirEmpresasEnTab;
        WorkspaceService.OnEventosRequest -= AbrirEventosEnTab;
        WorkspaceService.OnPageVisitsRequest -= AbrirPageVisitsEnTab;
        WorkspaceService.OnPublicacionesRequest -= AbrirPublicacionesEnTab;
    }

    private void RenameCurrentTab(string tabName, string iconText)
    {
        if (tabsList.Any() && tabsSelectedIndex < tabsList.Count)
        {
            tabsList[tabsSelectedIndex].Text = tabName;
            tabsList[tabsSelectedIndex].Icono = iconText;
            base.StateHasChanged();
        }
    }

    private void SetTabState(TipoEstadoControl tabState)
    {
        if (tabsList.Any() && tabsSelectedIndex < tabsList.Count)
        {
            tabsList[tabsSelectedIndex].EstadoControl = tabState;
        }
    }

    private void OnTabChanged(int index)
    {
        if (index >= 0 && index < tabsList.Count)
        {
            tabsSelectedIndex = index;
            var activeTab = tabsList.ElementAtOrDefault(index);

            if (activeTab?.InstanciaComponente != null)
            {
                activeTab.InstanciaComponente.TriggerMenuUpdate();
            }
            else
            {
                WorkspaceService.SetMenuItems(new List<MenuItemModel>());
            }
        }
    }

    private void AddTab(WorkspaceTab tab)
    {
        if (tab.Repetir)
        {
            tabsList.Add(tab);
            tabsSelectedIndex = tabsList.Count - 1;
            base.StateHasChanged();
            return;
        }

        var instanciaTab = tabsList
            .Select((t, index) => new { Tab = t, Index = index })
            .FirstOrDefault(m => m.Tab.TipoControl == tab.TipoControl);

        if (instanciaTab != null)
        {
            tabsSelectedIndex = instanciaTab.Index;
            // Si ya existe, forzar actualización del menú
            OnTabChanged(tabsSelectedIndex);
        }
        else
        {
            tabsList.Add(tab);
            tabsSelectedIndex = tabsList.Count - 1;
        }

        base.StateHasChanged();
    }

    private async Task CloseCurrentTabAsync(bool withWarning = false, Guid? specificTabId = null)
    {
        bool canClose = true;
        int indexToRemove = tabsSelectedIndex;

        if (specificTabId.HasValue)
        {
            indexToRemove = tabsList.FindIndex(t => t.Id == specificTabId.Value);
            if (indexToRemove < 0) return;
        }

        if (withWarning)
        {
            var parameters = new DialogParameters { { "ContentText", "Tienes cambios sin guardar en esta pestaña. ¿Seguro que deseas cerrarla?" } };
            var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Atención", parameters);
            var result = await dialog.Result;
            canClose = !result.Canceled;
        }

        if (canClose)
        {
            tabsList.RemoveAt(indexToRemove);
            
            // Reajustar indice si es necesario
            if (tabsSelectedIndex >= tabsList.Count)
            {
                tabsSelectedIndex = Math.Max(0, tabsList.Count - 1);
            }
            else if (indexToRemove < tabsSelectedIndex)
            {
                tabsSelectedIndex--;
            }
            
            base.StateHasChanged();
            if (tabsList.Any())
            {
                OnTabChanged(tabsSelectedIndex);
            }
            else
            {
                WorkspaceService.SetMenuItems(new List<MenuItemModel>());
            }
        }
    }

    private async Task CloseOtherTabsAsync()
    {
        var parameters = new DialogParameters { { "ContentText", "¿Seguro que deseas cerrar todas las pestañas excepto la actual?" } };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Atención", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var activeTab = tabsList[tabsSelectedIndex];
            tabsList.Clear();
            tabsList.Add(activeTab);
            tabsSelectedIndex = 0;
            StateHasChanged();
        }
    }

    private async Task CloseAllTabsAsync()
    {
        var parameters = new DialogParameters { { "ContentText", "¿Seguro que deseas cerrar todas las pestañas abiertas?" } };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Atención", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            tabsList.Clear();
            tabsSelectedIndex = 0;
            WorkspaceService.SetMenuItems(new List<MenuItemModel>());
            StateHasChanged();
        }
    }

    private void AbrirTramitesEnTab()
    {
        CloseMobileMenu();
        var type = typeof(SantiagoConectaIA.PWA.Areas.TramitesAreas.Componentes.GridTramites);
        var tab = new WorkspaceTab
        {
            Icono = Icons.Material.Filled.Description,
            Text = "Trámites",
            TipoControl = type,
            Repetir = false
        };

        tab.Componente = builder =>
        {
            builder.OpenComponent(0, type);
            builder.AddComponentReferenceCapture(1, instance =>
            {
                if (instance is EngramaWorkspaceComponent baseComponent)
                {
                    tab.InstanciaComponente = baseComponent;
                    baseComponent.IconoBase = tab.Icono ?? "";
                    if (tabsList.Count > 0 && tabsList[tabsSelectedIndex].Id == tab.Id)
                    {
                        baseComponent.TriggerMenuUpdate();
                    }
                }
            });
            builder.CloseComponent();
        };

        WorkspaceService.AddComponenteTab(tab);
    }

