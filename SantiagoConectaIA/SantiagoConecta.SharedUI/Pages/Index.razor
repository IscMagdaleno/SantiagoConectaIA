@page "/"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using SantiagoConecta.SharedUI.Data
@using SantiagoConectaIA.Share.PostModels.BuzonCiudadanoModule
@using SantiagoConectaIA.Share.Objects.NoticiasModule
@using SantiagoConectaIA.Share.PostModels.NoticiasModule
@using SantiagoConectaIA.Share.Objects.EventosModulo
@using SantiagoConectaIA.Share.Objects.InformacionLocalModule
@using SantiagoConectaIA.Share.PostClass.EventosModulo
@using SantiagoConectaIA.Share.PostModels.InformacionLocalModule
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject Data_BuzonCiudadano _dataBuzon
@inject Data_Noticias dataNoticias
@inject Data_Eventos dataEventos
@inject Data_InformacionLocal dataInformacionLocal
@inject AsistenteIaService Asistente
@inject SitioInterop Sitio

<SeoHead Titulo="Santiago Conecta | Trámites, noticias y negocios de Santiago Papasquiaro"
         Descripcion="@SeoHead.DescripcionPorDefecto" />

<!-- Bienvenida: fondo animado con partículas que reaccionan al puntero -->
<section class="home-hero" @ref="_hero" aria-labelledby="home-titulo">
    <div class="home-hero-glow" @ref="_glow" aria-hidden="true"></div>
    <canvas class="home-hero-canvas" @ref="_canvas" aria-hidden="true"></canvas>

    <div class="container home-hero-capa">
        <div class="home-hero-contenido">
            <p class="home-eyebrow">
                <MudIcon Icon="@Icons.Material.Rounded.LocationOn" /> Santiago Papasquiaro, Durango
            </p>
            <h1 id="home-titulo" class="home-h1">
                Trámites, noticias y negocios de <span class="home-h1-destacado">Santiago</span> en un solo lugar
            </h1>
            <p class="home-subtitulo">Encuentra lo que necesitas en segundos o pregúntale a nuestro asistente con IA.</p>

            <form class="home-busqueda" role="search" @onsubmit="Buscar">
                <label for="home-q" class="visualmente-oculto">Buscar en Santiago Conecta</label>
                <MudIcon Icon="@Icons.Material.Rounded.Search" Class="home-busqueda-icono" />
                <input id="home-q" type="search" @bind="_busqueda" @bind:event="oninput"
                       placeholder="Busca un trámite, noticia o negocio" autocomplete="off" enterkeyhint="search" />
                <button type="submit" class="home-boton">Buscar</button>
            </form>

            <div class="home-atajos">
                <button type="button" class="home-chip home-chip-ia" @onclick="Asistente.AbrirAsync">
                    <MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" /> Pregúntale a la IA
                </button>
                <a class="home-chip" href="@WhatsAppUrl" target="_blank" rel="noopener">
                    <MudIcon Icon="@Icons.Material.Rounded.Chat" /> WhatsApp
                </a>
                <a class="home-chip" href="/unete">
                    <MudIcon Icon="@Icons.Material.Rounded.Favorite" /> Únete a la comunidad
                </a>
            </div>
        </div>
    </div>

    <div class="home-ondas" aria-hidden="true">
        <svg class="home-ondas-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
                <path id="home-onda" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
            </defs>
            <g class="home-ondas-capas">
                <use xlink:href="#home-onda" x="48" y="0" fill="rgba(255,255,255,0.7)" />
                <use xlink:href="#home-onda" x="48" y="3" fill="rgba(255,255,255,0.5)" />
                <use xlink:href="#home-onda" x="48" y="5" fill="rgba(255,255,255,0.3)" />
                <use xlink:href="#home-onda" x="48" y="7" fill="#ffffff" />
            </g>
        </svg>
    </div>
</section>
<!-- Accesos rápidos -->
<section class="home-seccion home-seccion-accesos" aria-labelledby="accesos-titulo">
    <div class="container">
        <h2 id="accesos-titulo" class="home-h2" data-revelar>Accesos rápidos</h2>
        <ul class="home-accesos">
            @foreach (var acceso in Accesos)
            {
                <li data-revelar>
                    <a href="@acceso.Href" class="home-acceso">
                        <span class="home-acceso-icono"><MudIcon Icon="@acceso.Icono" /></span>
                        <span class="home-acceso-texto">
                            <span class="home-acceso-titulo">@acceso.Titulo</span>
                            <span class="home-acceso-desc">@acceso.Descripcion</span>
                        </span>
                    </a>
                </li>
            }
            <li data-revelar>
                <button type="button" class="home-acceso" @onclick='() => Sitio.IrASeccionAsync("contacto")'>
                    <span class="home-acceso-icono"><MudIcon Icon="@Icons.Material.Rounded.MarkunreadMailbox" /></span>
                    <span class="home-acceso-texto">
                        <span class="home-acceso-titulo">Buzón ciudadano</span>
                        <span class="home-acceso-desc">Quejas y sugerencias</span>
                    </span>
                </button>
            </li>
        </ul>
    </div>
</section>

<!-- Lo más reciente: noticias y eventos -->
@if (_cargando || noticias.Any() || eventos.Any())
{
    <section class="home-seccion home-seccion-rosa" aria-labelledby="recientes-titulo">
        <div class="container">
            <h2 id="recientes-titulo" class="home-h2" data-revelar>Lo más reciente</h2>

            @if (_cargando)
            {
                <div class="home-tarjetas" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="home-tarjeta home-esqueleto">
                            <div class="home-tarjeta-imagen"></div>
                            <div class="home-tarjeta-cuerpo">
                                <span class="home-esqueleto-linea corta"></span>
                                <span class="home-esqueleto-linea"></span>
                                <span class="home-esqueleto-linea"></span>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (noticias.Any())
            {
                <div class="home-subencabezado" data-revelar>
                    <h3 class="home-h3">Noticias</h3>
                    <a href="/noticias" class="home-ver-todo">Ver todas <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" /></a>
                </div>
                <div class="home-tarjetas">
                    @for (var i = 0; i < noticias.Count; i++)
                    {
                        var noticia = noticias[i];
                        <article class="@(i == 0 ? "home-tarjeta home-tarjeta-destacada" : "home-tarjeta")" data-revelar>
                            <a href="@($"/noticias/{noticia.iIdNoticia}")" class="home-tarjeta-enlace">
                                <div class="home-tarjeta-imagen">
                                    @if (!string.IsNullOrWhiteSpace(noticia.vchImagenPortada))
                                    {
                                        <img src="@noticia.vchImagenPortada" alt="@noticia.vchTitulo" width="640" height="360" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Rounded.Newspaper" Class="home-tarjeta-placeholder" />
                                    }
                                    @if (i == 0)
                                    {
                                        <span class="home-insignia">Lo último</span>
                                    }
                                </div>
                                <div class="home-tarjeta-cuerpo">
                                    <span class="home-etiqueta">@(noticia.Categoria?.vchNombre ?? "Noticia")</span>
                                    <h4 class="home-h4">@noticia.vchTitulo</h4>
                                    <time class="home-meta" datetime="@noticia.dtFechaPublicacion.ToString("yyyy-MM-dd")">
                                        @noticia.dtFechaPublicacion.ToString("d 'de' MMMM yyyy", EsMx)
                                    </time>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            }

            @if (eventos.Any())
            {
                <div class="home-subencabezado" data-revelar>
                    <h3 class="home-h3">Próximos eventos</h3>
                    <a href="/eventos" class="home-ver-todo">Ver agenda <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" /></a>
                </div>
                <div class="home-tarjetas">
                    @for (var i = 0; i < eventos.Count; i++)
                    {
                        var evento = eventos[i];
                        <article class="@(i == 0 ? "home-tarjeta home-tarjeta-destacada" : "home-tarjeta")" data-revelar>
                            <a href="@($"/eventos/{evento.iIdEvento}")" class="home-tarjeta-enlace">
                                <div class="home-tarjeta-imagen">
                                    @if (!string.IsNullOrWhiteSpace(evento.vchImagenPortada))
                                    {
                                        <img src="@evento.vchImagenPortada" alt="@evento.vchNombre" width="640" height="360" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Rounded.Event" Class="home-tarjeta-placeholder" />
                                    }
                                    @if (i == 0)
                                    {
                                        <span class="home-insignia">Próximo</span>
                                    }
                                    @if (evento.dtFechaInicio != DateTime.MinValue)
                                    {
                                        <span class="home-fecha" aria-hidden="true">
                                            <span class="home-fecha-dia">@evento.dtFechaInicio.Day</span>
                                            <span class="home-fecha-mes">@evento.dtFechaInicio.ToString("MMM", EsMx)</span>
                                        </span>
                                    }
                                </div>
                                <div class="home-tarjeta-cuerpo">
                                    <span class="home-etiqueta">@(string.IsNullOrWhiteSpace(evento.vchCostoTexto) ? "Entrada libre" : evento.vchCostoTexto)</span>
                                    <h4 class="home-h4">@evento.vchNombre</h4>
                                    <p class="home-meta">
                                        <time datetime="@evento.dtFechaInicio.ToString("yyyy-MM-ddTHH:mm")">@evento.dtFechaInicio.ToString("dddd d 'de' MMMM, HH:mm", EsMx)</time>
                                        @if (!string.IsNullOrWhiteSpace(evento.vchLugar))
                                        {
                                            <span> · @evento.vchLugar</span>
                                        }
                                    </p>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- Invitación para negocios -->
<section class="home-seccion home-seccion-blanca" aria-labelledby="negocio-titulo">
    <div class="container" data-revelar>
        <div class="home-negocio">
            <div>
                <h2 id="negocio-titulo" class="home-h2 sin-margen">¿Tienes un negocio en Santiago?</h2>
                <p class="home-negocio-texto">Regístralo gratis en el catálogo digital, sube tus productos y llega a más clientes.</p>
            </div>
            <a href="/registro-emprendimiento" class="home-boton">
                <MudIcon Icon="@Icons.Material.Rounded.AddBusiness" /> Registrar mi negocio
            </a>
        </div>
    </div>
</section>

<!-- Descubre el municipio (datos curiosos) -->
@if (datosCuriosos.Any())
{
    <section class="home-seccion home-seccion-oscura" aria-labelledby="descubre-titulo">
        <div class="container">
            <h2 id="descubre-titulo" class="home-h2" data-revelar>Descubre Santiago Papasquiaro</h2>
            <div class="home-tarjetas">
                @foreach (var dato in datosCuriosos)
                {
                    <article class="home-dato" data-revelar>
                        <div class="home-dato-tarjeta">
                        <span class="home-acceso-icono"><MudIcon Icon="@IconoCategoria(dato.nvchCategoria)" /></span>
                        <span class="home-etiqueta">@dato.nvchCategoria</span>
                        <h3 class="home-h4">@dato.nvchTitulo</h3>
                        <p class="home-dato-texto">@dato.nvchDescripcionCorta</p>
                        <button type="button" class="home-enlace-accion" @onclick="Asistente.AbrirAsync">
                            Pregúntale a la IA <MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" />
                        </button>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<!-- Buzón ciudadano -->
<section class="home-seccion home-seccion-rosa" id="contacto" aria-labelledby="buzon-titulo">
    <div class="container">
        <div class="home-buzon">
            <div class="home-buzon-info" data-revelar>
                <h2 id="buzon-titulo" class="home-h2">Buzón ciudadano</h2>
                <p class="home-buzon-texto">Envíanos tus comentarios, sugerencias o reportes. Te respondemos por correo.</p>
                <ul class="home-contacto">
                    <li>
                        <MudIcon Icon="@Icons.Material.Rounded.Email" />
                        <a href="mailto:santiagoconecta01@gmail.com">santiagoconecta01@gmail.com</a>
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Rounded.Phone" />
                        <span><a href="tel:+526741065612">674 106 5612</a> · <a href="tel:+523328340146">332 834 0146</a></span>
                    </li>
                    <li>
                        <MudIcon Icon="@Icons.Material.Rounded.Schedule" />
                        <span>Lunes a viernes, 8:00 a 15:00 h</span>
                    </li>
                </ul>
            </div>

            <div class="home-buzon-form" data-revelar>
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <p class="home-aviso exito" role="status">
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" /> @_successMessage
                    </p>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <p class="home-aviso error" role="alert">
                        <MudIcon Icon="@Icons.Material.Rounded.Error" /> @_errorMessage
                    </p>
                }
                <EditForm Model="@contactModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="home-form-grid">
                        <MudTextField @bind-Value="contactModel.Name" For="@(() => contactModel.Name)" Label="Nombre completo" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="contactModel.Email" For="@(() => contactModel.Email)" Label="Correo electrónico" Variant="Variant.Outlined" InputType="InputType.Email" />
                        <MudTextField @bind-Value="contactModel.Phone" Label="Teléfono (opcional)" Variant="Variant.Outlined" InputType="InputType.Telephone" />
                        <MudSelect T="string" @bind-Value="contactModel.Category" Label="Categoría" Variant="Variant.Outlined">
                            @foreach (var categoria in Categorias)
                            {
                                <MudSelectItem Value="@categoria">@categoria</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="contactModel.Message" For="@(() => contactModel.Message)" Label="Tu mensaje" Variant="Variant.Outlined" Lines="4" Class="home-form-completo" />
                    </div>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               FullWidth="true" Class="home-form-enviar" Disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            @("Enviando...")
                        }
                        else
                        {
                            @("Enviar mensaje")
                        }
                    </MudButton>
                </EditForm>
            </div>
        </div>
    </div>
</section>

<style>
    /* Modo captura de Instagram (4:5): debe ser global para ocultar el header y el footer del MainLayout */
    @@media (aspect-ratio: 4/5) {
        .header-area, footer { display: none !important; }
    }
</style>

@code {
    private ElementReference _hero;
    private ElementReference _canvas;
    private ElementReference _glow;
    private const string WhatsAppUrl = "https://wa.me/5212206490951";
    private static readonly CultureInfo EsMx = new("es-MX");
    private static readonly string[] Categorias = { "Queja", "Sugerencia", "Reporte", "Solicitud", "Otro" };

    private sealed record Acceso(string Titulo, string Descripcion, string Icono, string Href);

    private static readonly Acceso[] Accesos =
    {
        new("Trámites", "Requisitos y costos", Icons.Material.Rounded.Description, "/tramites"),
        new("Noticias", "Avisos oficiales", Icons.Material.Rounded.Newspaper, "/noticias"),
        new("Eventos", "Agenda cultural", Icons.Material.Rounded.Event, "/eventos"),
        new("Emprendimientos", "Negocios locales", Icons.Material.Rounded.Storefront, "/emprendimientos"),
        new("Feed", "Lo más reciente", Icons.Material.Rounded.DynamicFeed, "/feed")
    };

    private string _busqueda = string.Empty;
    private bool _cargando = true;
    private List<Noticia> noticias = new();
    private List<Evento> eventos = new();
    private List<InformacionLocal> datosCuriosos = new();

    private ContactModel contactModel = new();
    private bool _isSubmitting;
    private string _successMessage = string.Empty;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarNoticiasAsync(), CargarEventosAsync(), CargarDatosCuriososAsync());
        _cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Sitio.IniciarParticulasAsync(_hero, _canvas, _glow);
            await Sitio.IniciarReveladoAsync(_hero);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Sitio.DetenerParticulasAsync();
        await Sitio.DetenerReveladoAsync();
    }

    private async Task CargarNoticiasAsync()
    {
        try
        {
            var response = await dataNoticias.PostGetAllNoticias(new PostGetNoticias { bActivo = true });
            if (response?.IsSuccess == true && response.Data != null)
            {
                noticias = response.Data.OrderByDescending(x => x.dtFechaPublicacion).Take(3).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando noticias: {ex.Message}");
        }
    }

    private async Task CargarEventosAsync()
    {
        try
        {
            var response = await dataEventos.PostGetEventos(new PostGetEventos { bDestacado = true, bEstatus = true });
            if (response?.IsSuccess == true && response.Data != null)
            {
                var hoy = DateTime.Today;
                var proximos = response.Data.Where(e => (e.dtFechaFin ?? e.dtFechaInicio) >= hoy).OrderBy(e => e.dtFechaInicio);
                eventos = (proximos.Any() ? proximos : response.Data.OrderByDescending(e => e.dtFechaInicio)).Take(3).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando eventos destacados: {ex.Message}");
        }
    }

    private async Task CargarDatosCuriososAsync()
    {
        try
        {
            var response = await dataInformacionLocal.PostGetInformacionLocal(new PostGetInformacionLocal { bActivo = true });
            if (response?.IsSuccess == true && response.Data != null)
            {
                datosCuriosos = response.Data.OrderBy(_ => Random.Shared.Next()).Take(3).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando datos curiosos: {ex.Message}");
        }
    }

    private void Buscar()
    {
        var q = (_busqueda ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(q))
        {
            NavManager.NavigateTo($"/buscar?q={Uri.EscapeDataString(q)}");
        }
    }

    private static string IconoCategoria(string? categoria)
    {
        var cat = categoria?.ToLowerInvariant() ?? string.Empty;

        if (cat.Contains("historia")) return Icons.Material.Rounded.HistoryEdu;
        if (cat.Contains("gastronom") || cat.Contains("comida")) return Icons.Material.Rounded.Restaurant;
        if (cat.Contains("leyenda") || cat.Contains("mito")) return Icons.Material.Rounded.AutoStories;
        if (cat.Contains("turismo") || cat.Contains("lugar")) return Icons.Material.Rounded.Map;
        if (cat.Contains("cultura") || cat.Contains("arte") || cat.Contains("tradici")) return Icons.Material.Rounded.Palette;
        if (cat.Contains("naturaleza") || cat.Contains("flora") || cat.Contains("fauna")) return Icons.Material.Rounded.Forest;

        return Icons.Material.Rounded.Lightbulb;
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _successMessage = string.Empty;
        _errorMessage = string.Empty;

        try
        {
            var postModel = new PostSaveBuzonCiudadano
            {
                nvchNombreCiudadano = contactModel.Name,
                nvchEmail = contactModel.Email,
                nvchTelefono = contactModel.Phone,
                nvchCategoria = contactModel.Category,
                nvchDescripcion = contactModel.Message
            };

            var result = await _dataBuzon.PostSaveReporte(postModel);

            if (result != null && result.IsSuccess)
            {
                _successMessage = "Tu mensaje fue enviado. ¡Gracias por tus comentarios!";
                contactModel = new();
            }
            else
            {
                _errorMessage = result?.Message ?? "No se pudo enviar tu mensaje. Intenta de nuevo.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión. Por favor, intenta más tarde.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class ContactModel
    {
        [Required(ErrorMessage = "Escribe tu nombre.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Escribe tu correo.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        public string Email { get; set; } = string.Empty;

        public string Phone { get; set; } = string.Empty;

        public string Category { get; set; } = "Sugerencia";

        [Required(ErrorMessage = "Escribe tu mensaje.")]
        public string Message { get; set; } = string.Empty;
    }
}
