@page "/buscar"
@using SantiagoConecta.SharedUI.Data
@using SantiagoConecta.SharedUI.Componentes.FeedArea
@using SantiagoConectaIA.Share.Objects.FeedModule
@using SantiagoConectaIA.Share.PostModels.FeedModule
@inject Data_Feed DataFeed
@inject NavigationManager NavManager

<PageTitle>Búsqueda - Santiago Conecta</PageTitle>

<!-- Hero Section: Premium animated waves background -->
<div class="custom-hero-header">
    <div class="container relative z-10 mx-auto px-4 text-center">
        <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size: 56px; color: #ffffff; animation: float 3s ease-in-out infinite; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.15));" />
        <h1 class="header-title mt-2">Búsqueda General</h1>
        <p class="header-subtitle">
            @(string.IsNullOrWhiteSpace(_query) ? "Encuentra trámites, noticias, eventos y cápsulas en Santiago Papasquiaro" : $"Resultados para: \"{_query}\"")
        </p>
        <div class="d-flex justify-center gap-3 mt-2">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Class="hero-back-btn"
                       Style="border-radius: 999px; text-transform: none; font-weight: 700; background: rgba(255, 255, 255, 0.95); color: #880e4f; box-shadow: 0 4px 15px rgba(0,0,0,0.15); transition: all 0.2s ease;"
                       OnClick='() => NavManager.NavigateTo("/feed")'>
                Volver al Feed
            </MudButton>
        </div>
    </div>
    <!-- Animated waves at bottom -->
    <div class="waves-wrapper">
        <svg class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
             viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
                <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
            </defs>
            <g class="parallax">
                <use xlink:href="#gentle-wave" x="48" y="0" fill="rgba(255, 255, 255, 0.7)" />
                <use xlink:href="#gentle-wave" x="48" y="3" fill="rgba(255, 255, 255, 0.5)" />
                <use xlink:href="#gentle-wave" x="48" y="5" fill="rgba(255, 255, 255, 0.3)" />
                <use xlink:href="#gentle-wave" x="48" y="7" fill="#ffffff" />
            </g>
        </svg>
    </div>
</div>

<div class="container py-6" style="min-height: 70vh;">

        <div class="row mb-4">
            <div class="col-lg-8 col-md-10">
                <div style="display: flex; gap: 8px; align-items: center; background: #fff; border-radius: 999px; padding: 6px 8px 6px 18px; box-shadow: 0 8px 24px rgba(136,14,79,0.1);">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Style="color: #880e4f;" />
                    <input @bind="_searchInput"
                           @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown"
                           placeholder="Nueva búsqueda..."
                           style="flex: 1; border: none; outline: none; background: transparent; font-size: 1rem; padding: 10px 4px; color: #333;" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Style="border-radius: 999px; text-transform: none; font-weight: 700; min-width: 110px;"
                               OnClick="RunSearchFromInput">
                        Buscar
                    </MudButton>
                </div>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage) && TotalCount == 0)
        {
            <MudAlert Severity="Severity.Warning">@_errorMessage</MudAlert>
        }
        else if (_result == null || TotalCount == 0)
        {
            <MudAlert Severity="Severity.Info">No se encontraron resultados. Intenta con otras palabras clave.</MudAlert>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="@($"Trámites ({_result.Tramites.Count})")" IsExpanded="@(_result.Tramites.Count > 0)" Disabled="@(_result.Tramites.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Tramites)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <FeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="@($"Noticias ({_result.Noticias.Count})")" IsExpanded="@(_result.Noticias.Count > 0)" Disabled="@(_result.Noticias.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Noticias)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <FeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="@($"Eventos ({_result.Eventos.Count})")" IsExpanded="@(_result.Eventos.Count > 0)" Disabled="@(_result.Eventos.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Eventos)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <FeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="@($"Cápsulas de Santiago ({_result.Capsulas.Count})")" IsExpanded="@(_result.Capsulas.Count > 0)" Disabled="@(_result.Capsulas.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Capsulas)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <FeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="@($"Comunidad ({_result.Publicaciones.Count})")" IsExpanded="@(_result.Publicaciones.Count > 0)" Disabled="@(_result.Publicaciones.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Publicaciones)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <FeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
</div>

<style>
    .hero-back-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.25) !important;
        background: #ffffff !important;
    }
</style>

@code {
    private string _query = string.Empty;
    private string _searchInput = string.Empty;
    private bool _isLoading;
    private string _errorMessage = string.Empty;
    private FeedSearchResult? _result;
    private string? _lastQuery;

    private int TotalCount =>
        (_result?.Tramites.Count ?? 0)
        + (_result?.Noticias.Count ?? 0)
        + (_result?.Eventos.Count ?? 0)
        + (_result?.Capsulas.Count ?? 0)
        + (_result?.Publicaciones.Count ?? 0);

    protected override async Task OnParametersSetAsync()
    {
        _query = GetQueryParam("q");
        _searchInput = _query;

        if (!string.IsNullOrWhiteSpace(_query) && !string.Equals(_query, _lastQuery, StringComparison.Ordinal))
        {
            _lastQuery = _query;
            await SearchAsync(_query);
        }
    }

    private string GetQueryParam(string key)
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return string.Empty;
        }

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && string.Equals(Uri.UnescapeDataString(kv[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(kv[1].Replace("+", " "));
            }
        }

        return string.Empty;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunSearchFromInput();
        }
    }

    private Task RunSearchFromInput()
    {
        var q = (_searchInput ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(q))
        {
            return Task.CompletedTask;
        }

        NavManager.NavigateTo($"/buscar?q={Uri.EscapeDataString(q)}");
        return Task.CompletedTask;
    }

    private async Task SearchAsync(string texto)
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        _result = null;
        StateHasChanged();

        try
        {
            var response = await DataFeed.PostSearchFeed(new PostSearchFeed
            {
                vchTexto = texto,
                iPage = 1,
                iPageSize = 50
            });

            if (response == null)
            {
                _errorMessage = "No se pudo realizar la búsqueda.";
                return;
            }

            if (!response.IsSuccess)
            {
                _errorMessage = response.Message ?? "No se encontraron resultados.";
                _result = response.Data ?? new FeedSearchResult();
                return;
            }

            _result = response.Data ?? new FeedSearchResult();
        }
        catch (Exception ex)
        {
            _errorMessage = "Error de conexión al buscar.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
