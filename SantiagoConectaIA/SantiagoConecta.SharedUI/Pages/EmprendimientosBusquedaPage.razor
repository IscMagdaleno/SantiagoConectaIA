@page "/emprendimientos/buscar"
@using SantiagoConecta.SharedUI.Data
@using SantiagoConecta.SharedUI.Componentes.EmprendimientosFeedArea
@using SantiagoConectaIA.Share.Objects.EmprendimientosFeedModule
@using SantiagoConectaIA.Share.PostModels.EmprendimientosFeedModule
@inject Data_EmprendimientosFeed DataFeed
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Búsqueda Emprendimientos - Santiago Conecta</PageTitle>

<!-- Hero Section: Premium animated waves background -->
<div class="custom-hero-header">
    <div class="container relative z-10 mx-auto px-4 text-center">
        <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="font-size: 56px; color: #ffffff; animation: float 3s ease-in-out infinite; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.15));" />
        <h1 class="header-title mt-2">Búsqueda de Emprendimientos</h1>
        <p class="header-subtitle">
            @(string.IsNullOrWhiteSpace(_query) ? "Encuentra negocios, productos y servicios en Santiago Papasquiaro" : $"Resultados para: \"{_query}\"")
        </p>
        <div class="d-flex justify-center gap-3 mt-2">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Class="hero-back-btn"
                       Style="border-radius: 999px; text-transform: none; font-weight: 700; background: rgba(255, 255, 255, 0.95); color: #880e4f; box-shadow: 0 4px 15px rgba(0,0,0,0.15); transition: all 0.2s ease;"
                       OnClick='() => NavManager.NavigateTo("/emprendimientos")'>
                Volver al Feed
            </MudButton>
        </div>
    </div>
    <!-- Animated waves at bottom -->
    <div class="waves-wrapper">
        <svg class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
             viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
                <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
            </defs>
            <g class="parallax">
                <use xlink:href="#gentle-wave" x="48" y="0" fill="rgba(255, 255, 255, 0.7)" />
                <use xlink:href="#gentle-wave" x="48" y="3" fill="rgba(255, 255, 255, 0.5)" />
                <use xlink:href="#gentle-wave" x="48" y="5" fill="rgba(255, 255, 255, 0.3)" />
                <use xlink:href="#gentle-wave" x="48" y="7" fill="#ffffff" />
            </g>
        </svg>
    </div>
</div>

<div class="container py-6" style="min-height: 70vh;">
    <EmprendimientosFeedSearchBar InitialQuery="@_query" OnSearch="HandleSearchFromBar" />

        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage) && TotalCount == 0)
        {
            <MudAlert Severity="Severity.Warning">@_errorMessage</MudAlert>
        }
        else if (_result == null || TotalCount == 0)
        {
            <MudAlert Severity="Severity.Info">No se encontraron resultados. Intenta con otras palabras clave.</MudAlert>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="@($"Emprendimientos ({_result.Emprendimientos.Count})")" IsExpanded="@(_result.Emprendimientos.Count > 0)" Disabled="@(_result.Emprendimientos.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Emprendimientos)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <EmprendimientosFeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="@($"Productos ({_result.Productos.Count})")" IsExpanded="@(_result.Productos.Count > 0)" Disabled="@(_result.Productos.Count == 0)">
                    <div class="row">
                        @foreach (var card in _result.Productos)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <EmprendimientosFeedCardComponent Card="card" />
                            </div>
                        }
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
</div>

<style>
    .hero-back-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.25) !important;
        background: #ffffff !important;
    }
</style>

@code {
    private string _query = string.Empty;
    private bool _isLoading;
    private string _errorMessage = string.Empty;
    private EmprendimientosFeedSearchResult? _result;
    private string? _lastQuery;
    private bool _subscribed;

    private int TotalCount =>
        (_result?.Emprendimientos.Count ?? 0)
        + (_result?.Productos.Count ?? 0);

    protected override async Task OnInitializedAsync()
    {
        if (!_subscribed)
        {
            NavManager.LocationChanged += OnLocationChanged;
            _subscribed = true;
        }

        await ApplyQueryFromUriAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await ApplyQueryFromUriAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search location change error: {ex.Message}");
        }
    }

    private async Task ApplyQueryFromUriAsync()
    {
        var q = GetQueryParam("q");
        if (string.Equals(q, _lastQuery, StringComparison.Ordinal))
        {
            return;
        }

        _query = q;
        _lastQuery = q;

        if (!string.IsNullOrWhiteSpace(q))
        {
            await SearchAsync(q);
        }
        else
        {
            _result = null;
            _errorMessage = string.Empty;
        }
    }

    /// <summary>
    /// In-page search: updates results without forceLoad. Also syncs the URL query.
    /// </summary>
    private async Task HandleSearchFromBar(string texto)
    {
        var q = (texto ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(q))
        {
            return;
        }

        _query = q;
        _lastQuery = q;

        var target = $"/emprendimientos/buscar?q={Uri.EscapeDataString(q)}";
        var currentRelative = NavManager.ToBaseRelativePath(NavManager.Uri);
        var targetRelative = target.TrimStart('/');

        // Soft URL update only when query actually changes (SPA, no full reload)
        if (!string.Equals(currentRelative, targetRelative, StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo(target, replace: true);
        }

        await SearchAsync(q);
    }

    private string GetQueryParam(string key)
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
        {
            return string.Empty;
        }

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && string.Equals(Uri.UnescapeDataString(kv[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(kv[1].Replace("+", " "));
            }
        }

        return string.Empty;
    }

    private async Task SearchAsync(string texto)
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        _result = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var response = await DataFeed.PostSearchEmprendimientosFeed(new PostSearchEmprendimientosFeed
            {
                vchTexto = texto,
                iPage = 1,
                iPageSize = 50
            });

            if (response == null)
            {
                _errorMessage = "No se pudo realizar la búsqueda.";
                return;
            }

            if (!response.IsSuccess)
            {
                _errorMessage = response.Message ?? "No se encontraron resultados.";
                _result = response.Data ?? new EmprendimientosFeedSearchResult();
                return;
            }

            _result = response.Data ?? new EmprendimientosFeedSearchResult();
        }
        catch (Exception ex)
        {
            _errorMessage = "Error de conexión al buscar.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            NavManager.LocationChanged -= OnLocationChanged;
            _subscribed = false;
        }
    }
}
