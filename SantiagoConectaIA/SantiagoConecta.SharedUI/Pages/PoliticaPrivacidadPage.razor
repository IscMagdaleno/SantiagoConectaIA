@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                    window.initPrivacyScrollSpy = function() {
                        const sections = Array.from(document.querySelectorAll('.privacy-section'));
                        const navLinks = Array.from(document.querySelectorAll('.quick-nav-list a'));
                        if (!sections.length || !navLinks.length) return;

                        function updateActiveSection() {
                            const scrollY = window.scrollY || window.pageYOffset;
                            const triggerPoint = scrollY + 160;
                            let currentSectionId = '';

                            const isAtBottom = (window.innerHeight + scrollY) >= (document.documentElement.scrollHeight - 60);
                            if (isAtBottom) {
                                currentSectionId = sections[sections.length - 1].id;
                            } else {
                                for (let i = 0; i < sections.length; i++) {
                                    const section = sections[i];
                                    const top = section.offsetTop;
                                    const bottom = top + section.offsetHeight;

                                    if (triggerPoint >= top && triggerPoint < bottom) {
                                        currentSectionId = section.id;
                                        break;
                                    }
                                }

                                if (!currentSectionId && sections.length > 0 && triggerPoint >= (sections[0].offsetTop - 200)) {
                                    currentSectionId = sections[0].id;
                                }
                            }

                            navLinks.forEach(link => {
                                const href = link.getAttribute('href') || '';
                                if (currentSectionId && href.endsWith('#' + currentSectionId)) {
                                    link.classList.add('active');
                                } else {
                                    link.classList.remove('active');
                                }
                            });
                        }

                        navLinks.forEach(link => {
                            link.addEventListener('click', function(e) {
                                const href = this.getAttribute('href');
                                if (href && href.includes('#')) {
                                    const id = href.split('#')[1];
                                    const target = document.getElementById(id);
                                    if (target) {
                                        e.preventDefault();
                                        const targetTop = target.getBoundingClientRect().top + window.pageYOffset - 90;
                                        window.scrollTo({ top: targetTop, behavior: 'smooth' });
                                        history.replaceState(null, null, '#' + id);
                                        navLinks.forEach(l => l.classList.remove('active'));
                                        this.classList.add('active');
                                    }
                                }
                            });
                        });

                        if (window.__privacyScrollHandler) {
                            window.removeEventListener('scroll', window.__privacyScrollHandler);
                        }
                        window.__privacyScrollHandler = updateActiveSection;
                        window.addEventListener('scroll', updateActiveSection, { passive: true });
                        updateActiveSection();
                    };
                    window.initPrivacyScrollSpy();
                ");
            }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                if (window.__privacyScrollHandler) {
                    window.removeEventListener('scroll', window.__privacyScrollHandler);
                    window.__privacyScrollHandler = null;
                }
            ");
        }
        catch { }
    }
}
