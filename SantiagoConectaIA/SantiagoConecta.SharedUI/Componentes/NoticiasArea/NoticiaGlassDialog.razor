@using SantiagoConectaIA.Share.Objects.NoticiasModule
@using SantiagoConecta.SharedUI.Componentes.OpinionArea
@using Microsoft.AspNetCore.Components.Web

<div class="glass-modal-overlay" @onclick="Cerrar">
    <div class="glass-modal-container" @onclick:stopPropagation="true">
        <!-- Barra superior estilo Instagram: Categoría, Fecha + Cerrar -->
        <div class="glass-modal-top-bar">
            <div class="glass-modal-header">
                <span class="glass-modal-tag">@(Noticia.Categoria?.vchNombre ?? "Noticia")</span>
                <span style="font-size: 0.82rem; color: #716b7c; font-weight: 600;">
                    @Noticia.dtFechaPublicacion.ToString("d 'de' MMMM yyyy", EsMx)
                </span>
            </div>

            <button type="button" class="glass-modal-close-btn" @onclick="Cerrar" title="Cerrar modal">
                <MudIcon Icon="@Icons.Material.Rounded.Close" />
            </button>
        </div>

        <div class="glass-modal-scroll">
            <!-- 1. Imagen completa / Carrusel estilo Instagram ARRIBA -->
            @{
                var listaImg = Imagenes;
            }
            @if (listaImg.Any())
            {
                <div class="glass-insta-media"
                     @ontouchstart="OnTouchStart"
                     @ontouchend="OnTouchEnd">
                    <div class="glass-insta-viewport">
                        <div class="glass-insta-track" style="transform: translateX(-@(_currentIndex * 100)%);">
                            @for (int i = 0; i < listaImg.Count; i++)
                            {
                                var img = listaImg[i];
                                <div class="glass-insta-slide">
                                    <img src="@img" class="glass-insta-blur-bg" alt="" aria-hidden="true" />
                                    <img src="@img"
                                         class="glass-insta-img"
                                         alt="@Noticia.vchTitulo"
                                         loading="lazy" />
                                </div>
                            }
                        </div>

                        @if (listaImg.Count > 1)
                        {
                            <div class="glass-insta-counter">
                                @(_currentIndex + 1) / @listaImg.Count
                            </div>

                            @if (_currentIndex > 0)
                            {
                                <button type="button"
                                        class="glass-insta-nav prev"
                                        @onclick="PrevSlide"
                                        @onclick:stopPropagation="true"
                                        title="Imagen anterior"
                                        aria-label="Imagen anterior">
                                    <MudIcon Icon="@Icons.Material.Rounded.ChevronLeft" />
                                </button>
                            }

                            @if (_currentIndex < listaImg.Count - 1)
                            {
                                <button type="button"
                                        class="glass-insta-nav next"
                                        @onclick="NextSlide"
                                        @onclick:stopPropagation="true"
                                        title="Imagen siguiente"
                                        aria-label="Imagen siguiente">
                                    <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" />
                                </button>
                            }
                        }
                    </div>

                    @if (listaImg.Count > 1)
                    {
                        <div class="glass-insta-dots">
                            @for (int i = 0; i < listaImg.Count; i++)
                            {
                                var idx = i;
                                <button type="button"
                                        class="glass-insta-dot @(idx == _currentIndex ? "active" : "")"
                                        @onclick="() => GoToSlide(idx)"
                                        @onclick:stopPropagation="true"
                                        aria-label="@($"Ir a imagen {idx + 1}")">
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <!-- 2. Título, contenido y comentarios ABAJO -->
            <div class="glass-modal-body-content">
                <h2 class="glass-modal-title">@Noticia.vchTitulo</h2>

                @if (!string.IsNullOrWhiteSpace(ContenidoHtml))
                {
                    <div class="glass-modal-text">
                        @((MarkupString)ContenidoHtml)
                    </div>
                }

                <div class="d-flex align-center justify-space-between pt-1">
                    <a href="@($"/noticias/{Noticia.iIdNoticia}")" class="home-ver-todo" style="font-size: 0.95rem;">
                        Ver noticia completa <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" />
                    </a>
                </div>

                <div class="glass-modal-opinions-wrap">
                    <OpinionThread TipoEntidad="NOTICIA"
                                   IdEntidad="Noticia.iIdNoticia"
                                   CssClass="glass-modal-opinions" />
                </div>
            </div>
        </div>
    </div>
</div>
