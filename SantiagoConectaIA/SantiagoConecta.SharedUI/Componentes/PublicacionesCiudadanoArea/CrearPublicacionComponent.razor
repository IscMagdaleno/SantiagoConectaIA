@using Microsoft.AspNetCore.Components.Forms
@using SantiagoConecta.SharedUI.Data
@using SantiagoConectaIA.Share.Objects.PublicacionCiudadanoModule
@using SantiagoConectaIA.Share.PostModels.PublicacionCiudadanoModule
@inject Data_PublicacionesCiudadano DataPublicaciones
@inject CiudadanoSession Session
@inject ISnackbar Snackbar

<MudPaper Elevation="3" Class="pa-5 mb-5" Style="border-radius: 20px; border: 1px solid #fce4ec; background: #ffffff;">
    <div class="d-flex align-center gap-3 mb-3">
        @if (!string.IsNullOrEmpty(Session.AvatarUrl))
        {
            <MudAvatar Style="width: 44px; height: 44px; border: 2px solid #cd4472;">
                <MudImage Src="@Session.AvatarUrl" />
            </MudAvatar>
        }
        else
        {
            <MudAvatar Color="Color.Primary" Style="width: 44px; height: 44px; font-weight: 700; background: linear-gradient(135deg, #9b45c9, #cd4472);">
                @(string.IsNullOrWhiteSpace(Session.Alias) ? "C" : Session.Alias.Substring(0, 1).ToUpper())
            </MudAvatar>
        }
        <div>
            <div class="d-flex align-center gap-1">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #333;">@Session.Alias</MudText>
                @if (Session.bCuentaVerificada)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Info" Style="font-size: 18px;" />
                }
            </div>
            <MudText Typo="Typo.caption" Style="color: #888;">Comparte con los ciudadanos de Santiago</MudText>
        </div>
    </div>

    @* SELECTOR DE CATEGORÍA *@
    <div class="mb-3">
        <MudText Typo="Typo.caption" Style="font-weight: 700; color: #666; text-transform: uppercase; letter-spacing: 0.5px;">Categoría</MudText>
        <div class="d-flex flex-wrap gap-2 mt-1">
            @foreach (var cat in _categorias)
            {
                <MudChip T="string"
                         Text="@cat.Nombre"
                         Icon="@cat.Icono"
                         Variant="@(_categoriaSeleccionada == cat.Clave ? Variant.Filled : Variant.Outlined)"
                         Color="@(_categoriaSeleccionada == cat.Clave ? Color.Secondary : Color.Default)"
                         OnClick="() => _categoriaSeleccionada = cat.Clave"
                         Style="font-weight: 600; font-size: 13px;" />
            }
        </div>
    </div>

    @* TÍTULO OPCIONAL *@
    <MudTextField @bind-Value="_titulo"
                  Placeholder="Título o asunto (opcional)"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-3"
                  Style="border-radius: 12px;" />

    @* TEXTAREA DE CONTENIDO *@
    <MudTextField @bind-Value="_contenidoTexto"
                  Placeholder="¿Qué está pasando en tu colonia, evento o comunidad? Escribe aquí..."
                  Variant="Variant.Outlined"
                  Lines="4"
                  Class="mb-3"
                  Style="border-radius: 12px; font-size: 15px;"
                  AutoGrow="true" />

    @* PREVISUALIZACIÓN DE MINIATURAS *@
    @if (_imagenesBase64.Any())
    {
        <div class="d-flex flex-wrap gap-3 mb-3">
            @for (int i = 0; i < _imagenesBase64.Count; i++)
            {
                int index = i;
                <div style="position: relative; width: 85px; height: 85px; border-radius: 12px; overflow: hidden; border: 2px solid #cd4472; box-shadow: 0 2px 6px rgba(0,0,0,0.12);">
                    <img src="@_imagenesBase64[index]" style="width: 100%; height: 100%; object-fit: cover;" alt="Foto" />
                    <button type="button"
                            @onclick="() => RemoverFoto(index)"
                            style="position: absolute; top: 3px; right: 3px; background: rgba(0,0,0,0.65); color: white; border: none; border-radius: 50%; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size: 14px;" />
                    </button>
                </div>
            }
        </div>
    }

    <div class="d-flex align-center justify-space-between pt-2" style="border-top: 1px solid #f3f3f3;">
        <label for="foto-input" style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: #fdf2f8; color: #cd4472; font-weight: 600; font-size: 13.5px; transition: background 0.2s;">
            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Style="font-size: 20px;" />
            <span>@(_imagenesBase64.Count > 0 ? $"Agregar más fotos ({_imagenesBase64.Count}/5)" : "Agregar fotos")</span>
        </label>
        <InputFile id="foto-input" OnChange="OnFilesSelected" multiple accept="image/*" style="display: none;" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="PublicarAsync"
                   Disabled="@(_isSaving || string.IsNullOrWhiteSpace(_contenidoTexto))"
                   StartIcon="@(_isSaving ? null : Icons.Material.Filled.Send)"
                   Style="border-radius: 999px; text-transform: none; font-weight: 700; padding: 6px 24px; background: linear-gradient(135deg, #cd4472, #9b45c9);">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Publicando...</span>
            }
            else
            {
                <span>Publicar</span>
            }
        </MudButton>
    </div>
</MudPaper>

@code {
    [Parameter] public EventCallback OnPublicacionGuardada { get; set; }

    private string? _titulo;
    private string _contenidoTexto = string.Empty;
    private string _categoriaSeleccionada = "Comunidad";
    private bool _isSaving = false;
    private List<string> _imagenesBase64 = new();

    private record CategoriaItem(string Clave, string Nombre, string Icono);

    private readonly List<CategoriaItem> _categorias = new()
    {
        new("Comunidad", "Comunidad", Icons.Material.Filled.Forum),
        new("Aviso", "Aviso", Icons.Material.Filled.Campaign),
        new("Pregunta", "Pregunta", Icons.Material.Filled.HelpOutline),
        new("Recomendacion", "Recomendación", Icons.Material.Filled.Recommend)
    };

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var files = e.GetMultipleFiles(5);
            foreach (var file in files)
            {
                if (_imagenesBase64.Count >= 5)
                {
                    Snackbar.Add("Máximo 5 imágenes por publicación.", Severity.Warning);
                    break;
                }

                // Redimensionar automáticamente imágenes grandes para no saturar memoria
                var resizedImage = await file.RequestImageFileAsync("image/jpeg", 1280, 1280);
                using var stream = resizedImage.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
                _imagenesBase64.Add(base64);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar imágenes: {ex.Message}", Severity.Error);
        }
    }

    private void RemoverFoto(int index)
    {
        if (index >= 0 && index < _imagenesBase64.Count)
        {
            _imagenesBase64.RemoveAt(index);
        }
    }

    private async Task PublicarAsync()
    {
        if (string.IsNullOrWhiteSpace(_contenidoTexto))
        {
            Snackbar.Add("Escribe un mensaje para tu publicación.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(Session.Token))
        {
            Snackbar.Add("Tu sesión no está activa. Inicia sesión nuevamente.", Severity.Error);
            return;
        }

        _isSaving = true;
        try
        {
            var model = new PostSavePublicacionCiudadano
            {
                nvchTitulo = _titulo,
                nvchContenidoTexto = _contenidoTexto,
                vchCategoriaPublicacion = _categoriaSeleccionada,
                ImagenesBase64 = _imagenesBase64
            };

            var response = await DataPublicaciones.PostSavePublicacion(model, Session.Token);
            if (response != null && response.IsSuccess)
            {
                Snackbar.Add("¡Tu publicación se ha compartido exitosamente!", Severity.Success);
                _titulo = null;
                _contenidoTexto = string.Empty;
                _imagenesBase64.Clear();
                _categoriaSeleccionada = "Comunidad";

                if (OnPublicacionGuardada.HasDelegate)
                {
                    await OnPublicacionGuardada.InvokeAsync();
                }
            }
            else
            {
                Snackbar.Add(response?.Message ?? "No se pudo guardar la publicación.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al publicar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
